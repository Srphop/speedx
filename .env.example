# ก๊อปไฟล์นี้เป็น .env แล้วใส่ค่า (ห้าม commit ไฟล์ .env ขึ้น GitHub)
# ไม่มีไฟล์ .env ก็รันได้ จะใช้ข้อมูลตัวอย่างในเครื่องแทน

# พอร์ตของเว็บตอนรันในเครื่อง (Render จะตั้ง PORT ให้เอง)
PORT=3222

# ใช้เซ็น token ตอนล็อกอิน ตั้งเป็นข้อความสุ่มยาว ๆ อะไรก็ได้
JWT_SECRET=change-me-to-a-long-random-string

# Google Sheets API (service account) ถ้าเว้นว่าง จะใช้ไฟล์ใน backend/data/ แทน
GOOGLE_SHEET_ID=1r5VFet5CQNn9Wecc5mqzuizzM9N5QeExn4HhBDzFGVU
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# (ไม่บังคับ) บังคับ "วันนี้" ไว้ซ้อมเดโม เช่น 2026-11-12T10:00:00+07:00
DEMO_NOW=
